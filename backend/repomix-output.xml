import axios from "axios";
import { NodeExecutionResult } from "../types";
import { getGoogleClient } from "../../lib/google";

export class SheetsNode {
  private config: any;

  constructor(config: any) {
    this.config = config ?? {};
  }

  async execute(input: any): Promise<NodeExecutionResult> {
    const sheetId = this.config.sheetId;
    const range = this.config.range ?? "Sheet1!A:Z";
    const mode = this.config.mode ?? "append"; // "append" | "read"
    const fallbackUrl = this.config.fallbackUrl ?? process.env.SHEETY_URL;

    try {
      if (!sheetId) {
        // fallback to simple API
        if (!fallbackUrl) {
          return { success: false, errorMessage: "sheetId or fallbackUrl required" };
        }
        const payload = this.config.row ?? input ?? {};
        const res = await axios.post(fallbackUrl, payload);
        return { success: true, output: { sheety_response: res.data } };
      }

      // REAL GOOGLE API MODE
      const sheets = getGoogleClient();

      if (mode === "append") {
        const row = this.config.row ?? input ?? {};
        const values = [Object.values(row)];

        await sheets.spreadsheets.values.append({
          spreadsheetId: sheetId,
          range,
          valueInputOption: "USER_ENTERED",
          requestBody: { values }
        });

        return { success: true, output: { google: "row_appended", values } };
      }

      if (mode === "read") {
        const result = await sheets.spreadsheets.values.get({
          spreadsheetId: sheetId,
          range
        });
        return { success: true, output: { rows: result.data.values ?? [] } };
      }

      return { success: false, errorMessage: "Invalid mode" };
    } catch (err: any) {
      return { success: false, errorMessage: String(err?.message ?? err) };
    }
  }
}
</file>

<file path="src/execution/nodes/slack.node.ts">
// src/execution/nodes/slack.node.ts
import axios from "axios";
import { NodeExecutionInput, NodeExecutionResult } from "../types";

interface SlackConfig {
  webhookUrl?: string;    
  token?: string;         // Bot token for advanced mode
  channel?: string;
  message?: string;
  blocks?: any[];
  threadTs?: string;
}

export class SlackNode {
  constructor(private config: SlackConfig = {}) {}

  async execute(input: NodeExecutionInput): Promise<NodeExecutionResult> {
    try {
      //  MODE 1: Incoming Webhook
      if (this.config.webhookUrl) {
        await axios.post(this.config.webhookUrl,
          { text: this.config.message ?? JSON.stringify(input) },
          { timeout: 8000 }
        );

        return { success: true, output: { sent: true, mode: "webhook" } };
      }

      //  MODE 2: Bot Token (Chat.postMessage)
      if (this.config.token && this.config.channel) {
        const payload: any = {
          channel: this.config.channel,
          text: this.config.message ?? "Workflow message",
          blocks: this.config.blocks ?? undefined,
          thread_ts: this.config.threadTs ?? undefined
        };

        const resp = await axios.post(
          "https://slack.com/api/chat.postMessage",
          payload,
          {
            headers: { Authorization: `Bearer ${this.config.token}` },
            timeout: 8000
          }
        );

        if (!resp.data.ok) {
          return { success: false, errorMessage: resp.data.error };
        }

        return { success: true, output: resp.data };
      }

      return { success: false, errorMessage: "Slack config incomplete" };
    } catch (err: any) {
      return { success: false, errorMessage: err.message };
    }
  }
}
</file>

